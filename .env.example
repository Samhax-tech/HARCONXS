# ==============================================================================
# HARCONXS ATELIER — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or configure directly in your Vercel Project Settings.
# IMPORTANT: NEVER commit real secret keys, production passwords, or tokens.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SITE METADATA
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://harconxs.com
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Service Role Secret Key (SERVER-SIDE ONLY - NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI CONCIERGE & COPILOT (Server-side)
# ------------------------------------------------------------------------------
# Google AI Studio API Key for luxury artisan assistant & auto-drafting
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. HARCONXS PRIVATE REST API & DEVELOPER GATEWAY
# ------------------------------------------------------------------------------
# Default public endpoint base for clients
HARCONXS_API_URL=https://harconxs.com/api
# Master developer root API key for server-to-server microservices
HARCONXS_API_KEY=hx_live_sec_your_internal_api_key_here

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS & BILLING INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Razorpay Credentials (UPI, Netbanking, Cards, EMI)
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Cashfree Payments (Instant UPI, QR & Cards)
VITE_CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENVIRONMENT=PRODUCTION

# Stripe Payments (Global USD/EUR/GBP Cards & Apple Pay)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Custom Billing Portal URL for Bot Panels & Digital Subscriptions
VITE_BILLING_URL=https://billing.harconxs.com

# ------------------------------------------------------------------------------
# 6. LOGISTICS & COURIER TRACKING (BlueDart, Delhivery, Shiprocket)
# ------------------------------------------------------------------------------
SHIPROCKET_API_USER=logistics@harconxs.com
SHIPROCKET_API_PASSWORD=your_shiprocket_api_password_here
DELHIVERY_API_TOKEN=your_delhivery_api_token_here
BLUEDART_CUSTOMER_CODE=your_bluedart_customer_code_here

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL & NOTIFICATION DISPATCH (Resend / SendGrid / SMTP)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
NOTIFICATION_FROM_EMAIL=concierge@harconxs.com
NOTIFICATION_FROM_NAME=HARCONXS Atelier Concierge

# ------------------------------------------------------------------------------
# 8. BOT PANELS & COMMUNITY INTEGRATIONS
# ------------------------------------------------------------------------------
# Telegram Bot Token (for VIP Gateway & Store notifications)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Discord Bot Integration (for Community VIP Guild & Support Alerts)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# WhatsApp Business Cloud API (for order tracking & OTP alerts)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
